function sshlog() {
        LOGDIR=~/sshlogs
        mkdir -p $LOGDIR
        date=$(date '+%y-%m-%d-%H%M%S')
        filename="${LOGDIR}/${1}_${date}.log"
        ssh $1 2>&1 | tee -ai $filename
        echo "ssh session saved in ${filename}"
}

function port-listen() {
        sudo lsof -i -P -n | grep LISTEN
}

function lesslt() {
        ls -1t "$1" | head -n 1 | xargs -I {} less -R "$1/{}"
}

function lesslt-col() {
        ls -1t "$1" | grep colored | head -n 1 | xargs -I {} less -R "$1/{}"
}

############################################
# Notifications
############################################

# Ring the terminal bell when a command takes longer than
# $CMD_NOTIFY_THRESHOLD seconds to finish. Zellij shows a bell
# indicator on the tab that ran it, even when unfocused.
zmodload zsh/datetime
autoload -Uz add-zsh-hook

typeset -g CMD_NOTIFY_THRESHOLD=5
typeset -g _cmd_notify_start=0

_cmd_notify_preexec() {
        _cmd_notify_start=$EPOCHSECONDS
}

_cmd_notify_precmd() {
        (( _cmd_notify_start == 0 )) && return
        local elapsed=$(( EPOCHSECONDS - _cmd_notify_start ))
        _cmd_notify_start=0
        (( elapsed < CMD_NOTIFY_THRESHOLD )) && return
        print -n '\a'
}

add-zsh-hook preexec _cmd_notify_preexec
add-zsh-hook precmd _cmd_notify_precmd

############################################
# Aliases
############################################

# Python alias
alias python="python3"
alias avenv="source venv/bin/activate"

# Zellij 
alias zrf='zellij run -f -- '

alias less-col='less -R +F '
alias ls-srvs='sudo lsof -i -P -n | grep LISTEN'

# Git
alias git-tags-list="git for-each-ref --sort=creatordate --format '%(refname) %(creatordate)' refs/tags"

# Home
alias wake-pvelab="wakeonlan 00:e0:4c:e1:08:82 -i 192.168.96.20"
